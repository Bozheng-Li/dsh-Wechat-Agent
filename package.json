{
  "name": "dsh-plugin-wechat-agent",
  "version": "0.2.0-preview.8",
  "description": "DeepSeek Harness 微信 Agent：统一拟人助手、自然聊天、持久记忆、按需看图、定时提醒与联网搜索",
  "keywords": [
    "dsh-plugin",
    "deepseek-harness",
    "wechat",
    "agent",
    "微信"
  ],
  "publishConfig": {
    "registry": "https://registry.npmjs.org/",
    "access": "public"
  },
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./package.json": "./package.json"
  },
  "files": [
    "lib/index.js",
    "lib/client.js",
    "lib/worker.cjs",
    "assets/stickers",
    "runtime",
    "cordis.patch.yml",
    "README.md",
    "LICENSE",
    "THIRD_PARTY_NOTICES.md",
    "CHANGELOG.md",
    "licenses",
    "config.yaml",
    "prompts/conversation/templates.json",
    "prompts/diagnostics/templates.json",
    "prompts/digests/templates.json",
    "prompts/identity/default.md",
    "prompts/memory/extraction.json",
    "prompts/memory/query.json",
    "prompts/recovery/templates.json",
    "prompts/reply/chat-task.md",
    "prompts/reply/configured-task.md",
    "prompts/reply/continuing-chat.md",
    "prompts/reply/current-turn.md",
    "prompts/reply/default-task.md",
    "prompts/reply/defaults.md",
    "prompts/reply/language.md",
    "prompts/tasks/templates.json",
    "prompts/vision/requests.json",
    "prompts/vision/tools.json",
    "prompts/work/system.md",
    "prompts/work/dialogue.md",
    "prompts/work/dialogue-tools.json",
    "prompts/work/tools.json",
    "prompts/work/result-polish.md",
    "prompts/work/progress.md",
    "prompts/work/routing.md",
    "prompts/remote/messages.json",
    "prompts/moments/reply.md",
    "prompts/moments/publish.md"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-connection",
        "@deepseek-ai/dsh-client-ui-renderer",
        "@deepseek-ai/dsh-client-ui-layout",
        "@deepseek-ai/dsh-client-ui-sidebar",
        "@deepseek-ai/dsh-client-ui-model-selection"
      ]
    }
  },
  "engines": {
    "node": ">=22.18",
    "dsh": "0.2.1-rc.5"
  },
  "os": [
    "win32"
  ],
  "cpu": [
    "x64"
  ],
  "license": "AGPL-3.0-or-later",
  "repository": {
    "type": "git",
    "url": "https://github.com/Bozheng-Li/dsh-Wechat-Agent.git"
  },
  "private": true,
  "homepage": "https://github.com/Bozheng-Li/dsh-Wechat-Agent#readme",
  "bugs": {
    "url": "https://github.com/Bozheng-Li/dsh-Wechat-Agent/issues"
  },
  "scripts": {
    "build": "node scripts/build-dsh-plugin.mjs",
    "test": "npm run build && node scripts/test.mjs",
    "test:native": "node scripts/test-dsh-native.cjs",
    "test:work-native": "node scripts/test-work-native.cjs",
    "test:work-parallel-native": "node scripts/test-work-parallel-native.cjs",
    "test:work-tools-native": "node scripts/test-work-tools-native.cjs",
    "test:remote-native": "node scripts/test-remote-native.cjs",
    "test:ui": "npm run build && node scripts/test-ui.mjs",
    "test:visual": "npm run build && node scripts/test-visual-system.mjs",
    "preview:workbench": "npm run build && node scripts/preview-workbench.mjs",
    "test:workbench-ui": "npm run build && node scripts/preview-workbench.mjs --test",
    "test:python": "python -B -m unittest discover -s tests -p native_engine_test.py",
    "engine:prepare": "node scripts/prepare-wechat-engine.mjs",
    "pack:plugin": "node scripts/build-dsh-plugin.mjs --pack",
    "audit:package": "node scripts/audit-dsh-package.mjs",
    "verify:npm": "node scripts/verify-npm-release.mjs",
    "dsh:build": "npm run build",
    "dsh:test": "npm test",
    "dsh:pack": "npm run pack:plugin",
    "test:structure": "node --test tests/source-structure.test.mjs"
  },
  "devDependencies": {
    "fast-xml-parser": "5.11.2",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "rolldown": "1.2.15",
    "tar": "7.5.22",
    "yaml": "2.9.1",
    "zod": "4.6.7"
  }
}
